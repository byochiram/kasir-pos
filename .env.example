# Salin file ini menjadi .env lalu ganti nilainya.

# Kunci penandatanganan JWT. WAJIB minimal 32 karakter dan rahasia.
# Buat yang acak: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter-yang-panjang

# Lokasi file database SQLite. Kosongkan untuk memakai ./kasir.db
# DATABASE_PATH=./kasir.db

# Password akun bawaan yang dibuat saat database masih kosong.
# Hanya dipakai sekali saat seeding; ganti sebelum dipakai di produksi.
SEED_ADMIN_PASSWORD=admin123
SEED_KASIR_PASSWORD=kasir123
