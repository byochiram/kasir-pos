# Salin file ini menjadi .env (development) atau .env.production (Docker),
# lalu ganti nilainya.

# ===== WAJIB =====

# Kunci penandatanganan sesi JWT. Minimal 32 karakter dan rahasia.
# Buat yang acak:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter-yang-panjang


# ===== OPSIONAL =====

# Lokasi file SQLite. Default ./kasir.db
# Di Docker sudah diarahkan ke /data/kasir.db lewat Dockerfile.
# DATABASE_PATH=./kasir.db

# Password akun bawaan, hanya dipakai sekali saat database masih kosong.
SEED_ADMIN_PASSWORD=admin123
SEED_KASIR_PASSWORD=kasir123


# ===== PEMBAYARAN QRIS (opsional) =====
# Tanpa ini, metode QRIS tetap muncul tapi akan menolak dengan pesan
# "belum dikonfigurasi". Metode lain tidak terpengaruh.
#
# Sandbox tidak butuh verifikasi badan usaha:
#   1. Daftar di https://dashboard.sandbox.midtrans.com
#   2. Pastikan pengalih Environment di dashboard menunjuk "Sandbox",
#      lalu Settings -> Access Keys -> salin Server Key.
#      Jangan menilai dari bentuk kunci: yang menentukan aplikasi menembak
#      sandbox atau produksi adalah MIDTRANS_IS_PRODUCTION di bawah, bukan
#      awalan kuncinya.
#   3. Settings -> Configuration -> Payment Notification URL:
#      https://domain-anda.com/api/payments/midtrans/webhook
#
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Penerbit QRIS: "gopay" (default) atau "airpay shopee".
# Tidak semua akun diaktifkan untuk keduanya; ganti bila simulator/pembayaran
# gagal padahal tagihan berhasil dibuat.
# MIDTRANS_QRIS_ACQUIRER=gopay
